{
  "name": "claude-rc",
  "version": "0.0.0",
  "description": "Unofficial remote-control panel for Claude Code sessions. Launch, manage and observe `claude --remote-control` sessions from your phone over your tailnet.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "claude-rc": "bin/claude-rc.mjs"
  },
  "files": [
    "bin",
    "core",
    "src",
    "hooks",
    ".output",
    "nuxt.config.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "prepare": "nuxt prepare",
    "preview": "node .output/server/index.mjs",
    "serve": "node bin/claude-rc.mjs serve",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@nuxt/ui": "^4.8.2",
    "@types/node": "^25.9.2",
    "nuxt": "^4.4.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  }
}
